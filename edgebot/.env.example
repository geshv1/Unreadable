# Copy this file to .env and fill in what you have. Never commit .env.
# Nothing here is needed for sample-data mode or for backtests on free data.

# Live odds (Phase 3). Paid service — only add after you approve it.
ODDS_API_KEY=

# Telegram bot (Phase 4). Get the token from @BotFather, your user ID from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Ask Anything AI layer (Phase 4, optional). Paid service — only add after you approve it.
ANTHROPIC_API_KEY=

# Optional: point to a different settings file.
# EDGEBOT_CONFIG=/path/to/config.yaml
